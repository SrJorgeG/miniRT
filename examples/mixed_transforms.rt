# Mixed Transformations - Combining rotations and translations
A 0.3 255,255,255
C -60,0,30 0,0,1 70
L -40,10,30 0.7 255,255,255

# Base ground
pl 0,0,-15 0,1.0,0 150,150,150

# Sphere with translation
sp 0,0,20 12 255,100,0 15,10,5

# Cylinder rotated and translated
# Rotated 45 degrees then moved
cy 0,0,20 0,0,1.0 10 20 100,0,255 30,0,0 20,-10,0

# Plane rotated and translated
pl 0,0,20 0,1.0,0 0,255,100 45,45,0 -20,5,10

# Another cylinder with different transformation
cy -30,0,30 0,0,1.0 8 15 100,100,0 60,30,15 10,5,0

# Cone with rotation and translation
# Format: cone top axis diameter height color [rotation] [translation]
co 0,0,20 0,0,1.0 12 25 200,100,0 45,30,0 -15,0,5
